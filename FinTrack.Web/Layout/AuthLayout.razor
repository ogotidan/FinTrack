@inherits LayoutComponentBase

<div class="auth-split">
    <div class="auth-left">
        <div class="auth-left-inner">
            <div class="brand-lg">
                <div class="glyph">F</div>
                <div>
                    <div class="word">FinTrack</div>
                    <div class="sub">by Finnet Technologies</div>
                </div>
            </div>
            <div>
                <div class="lead-title">Portfolio &amp; transactions tracking for investment analysts.</div>
                <div class="lead-sub">Register client portfolios, record buy &amp; sell trades, and see current holdings and performance at a glance.</div>
                <div class="feat">
                    <div class="f"><i class="fa-solid fa-briefcase"></i> Manage multiple client portfolios</div>
                    <div class="f"><i class="fa-solid fa-arrow-right-arrow-left"></i> Record buy &amp; sell transactions</div>
                    <div class="f"><i class="fa-solid fa-chart-pie"></i> Holdings &amp; allocation at a glance</div>
                </div>
            </div>
            <div class="foot">&copy; @DateTime.Now.Year Finnet Technologies</div>
        </div>
    </div>
    <div class="auth-right">
        <div class="auth-right-inner">
            @Body
        </div>
    </div>
</div>
