@inherits LayoutComponentBase

<div class="pmp-shell">
    <NavMenu />
    <div class="pmp-main">
        <div class="pmp-topbar">
            <div class="topbar-title">FinTrack</div>
            <div class="topbar-right">
                <span class="topbar-date">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span>
                <span class="topbar-badge">Analyst</span>
            </div>
        </div>
        <div class="pmp-content">
            @Body
        </div>
    </div>
    <ActionOverlay />
</div>
