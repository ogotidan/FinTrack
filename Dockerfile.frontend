# FinTrack Web (Blazor WebAssembly, .NET 10) served by nginx
# Build from the repo root:  docker build -f Dockerfile.frontend -t fintrack-web .

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY FinTrack.Web/FinTrack.Web.csproj FinTrack.Web/
RUN dotnet restore FinTrack.Web/FinTrack.Web.csproj

COPY FinTrack.Web/ FinTrack.Web/
RUN dotnet publish FinTrack.Web/FinTrack.Web.csproj -c Release -o /app/publish --no-restore

FROM nginx:1.27-alpine AS runtime


ENV API_BASE_URL=https://fintrackapi.elitesgroup.co.ke

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/40-fintrack-config.sh /docker-entrypoint.d/40-fintrack-config.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-fintrack-config.sh /etc/nginx/conf.d/default.conf \
 && chmod +x /docker-entrypoint.d/40-fintrack-config.sh

COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
